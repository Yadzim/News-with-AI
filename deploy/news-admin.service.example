[Unit]
Description=AI News Admin API + Schedule
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/news-bot
EnvironmentFile=/var/www/news-bot/.env
ExecStart=/usr/bin/npm run admin
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
