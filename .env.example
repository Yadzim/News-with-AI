GEMINI_API_KEY=your_gemini_api_key
# Tahlil modeli. Kvotasi tugasa avtomatik FALLBACK ga o‘tiladi.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
# Kvotasi tugagan model necha daqiqa chetlatib turilsin
GEMINI_COOLDOWN_MINUTES=30

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_ID=-100XXXXXXXXXX
# Kanal ID (@username yoki -100...)
TELEGRAM_CHANNEL_ID=@your_channel
# Muhim: superguruh ID oldida minus (-) bo‘lishi shart (-100...)

# --- Admin panel himoyasi (kamida bittasi MAJBURIY) --------------------------
# Ikkalasi ham bo‘sh bo‘lsa `npm run admin` ishga tushmaydi.
# Kalit yaratish: openssl rand -hex 32   (kamida 24 belgi)
ADMIN_TOKEN=
# Mini App orqali kalitsiz kirish uchun ruxsat etilgan Telegram user ID lar
# (vergul bilan). O‘z ID ingizni @userinfobot dan olsangiz bo‘ladi.
ADMIN_USER_IDS=

# --- Kategoriyalar (faqat birinchi ishga tushirish uchun) --------------------
# Shundan keyin kategoriyalar admin panelidan boshqariladi (qo‘shish, o‘chirish,
# topic biriktirish). Bo‘sh qoldirilgan kategoriya guruhning umumiy topic’iga
# post qiladi.
TOPIC_AI=1
TOPIC_HARDWARE=2
TOPIC_CYBERSECURITY=3
TOPIC_STARTUPS=4
TOPIC_GENERAL_TECH=5

# --- Ovozli xabar (TTS) -----------------------------------------------------
# Yoqish/o‘chirish admin panelidan. Serverda ffmpeg bo‘lishi shart:
#   sudo apt install -y ffmpeg
# Audio FAQAT kanalga yuboriladi (guruhga emas) — kvotani tejash uchun.
# Ovoz modeli ham ikkita — birinchisining kvotasi tugasa ikkinchisi
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL_FALLBACK=gemini-2.5-pro-preview-tts
TTS_VOICE=Kore

DATABASE_PATH=./data/news.db
PORT=8787

# Telegram Mini App URL (https://...)
WEBAPP_URL=
